{
  "name": "backend-easy",
  "version": "1.0.0",
  "description": "Backend MVC con API REST y vista principal",
  "main": "src/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "db:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-db.ps1",
    "db:push": "node scripts/with-env.js db push",
    "db:migrate": "node scripts/with-env.js migrate dev",
    "db:migrate:deploy": "node scripts/with-env.js migrate deploy",
    "db:verify": "node scripts/verify-mysql.js",
    "db:studio": "node scripts/with-env.js studio",
    "db:seed": "node prisma/seed.js",
    "db:seed-ubigeo": "node scripts/seed-ubigeo.js",
    "start": "node src/server.js",
    "dev": "node scripts/dev-server.js",
    "dev:server": "node scripts/dev-server.js",
    "db:generate": "node scripts/with-env.js generate",
    "db:import-codigos-sunat": "node scripts/import-codigos-producto-sunat.js",
    "db:limpiar-servicios-compras": "node scripts/limpiar-servicios-catalogo-compras.js",
    "test:compras-recibidos": "node scripts/test-compras-recibidos.js",
    "test:smoke-compras": "node scripts/smoke-compras-api.js",
    "test:web-app-panel": "node scripts/test-web-app-panel.js",
    "test:analisis-margen": "node scripts/test-analisis-margen.js",
    "test:unit": "node tests/run-unit.js",
    "test": "node tests/run-unit.js",
    "db:migrate-recibidos-compras": "node scripts/migrate-recibidos-invoices-to-compras.js"
  },
  "keywords": [
    "mvc",
    "rest",
    "api",
    "nodejs"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "node-forge": "^1.4.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "prisma": "^6.9.0",
    "xlsx": "^0.18.5"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
