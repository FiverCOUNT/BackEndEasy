generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  PENDIENTE
  BLOQUEADO
}

enum RolUsuario {
  ADMIN
  USUARIO
  /// Acceso al panel web /admin (gestión de empresas / plataforma).
  SUPER_ADMIN
}

model Company {
  id                       BigInt   @id @default(autoincrement())
  ruc                      String   @default("") @db.VarChar(11)
  nombre                   String   @db.VarChar(255)
  nombreComercial          String?  @map("nombre_comercial") @db.VarChar(255)
  tipoDoc                  String?  @map("tipo_doc") @db.VarChar(2)
  numeroDoc                String?  @map("numero_doc") @db.VarChar(20)
  /// Snapshot de dirección (ubigeo, distrito, mz/lote…). Ya no usa FK a addresses.
  addressJson              Json?    @map("address_json")
  email                    String?  @db.VarChar(255)
  telefono                 String?  @db.VarChar(30)
  telefonos                Json?
  emails                   Json?
  cuentasBancarias         Json?    @map("cuentas_bancarias")
  billeterasDigitales      Json?    @map("billeteras_digitales")
  mensajeAgradecimiento    String?  @map("mensaje_agradecimiento") @db.Text
  mensajePromocional       String?  @map("mensaje_promocional") @db.Text
  solUser                  String?  @map("sol_user") @db.VarChar(100)
  solPass                  String?  @map("sol_pass") @db.VarChar(255)
  clientId                 String?  @map("client_id") @db.VarChar(255)
  clientSecret             String?  @map("client_secret") @db.VarChar(255)
  rutaFirma                String?  @map("ruta_firma") @db.VarChar(500)
  certificatePassword      String?  @map("certificate_password") @db.VarChar(255)
  rutaLogo                 String?  @map("ruta_logo") @db.VarChar(500)
  nameLogo                 String?  @map("name_logo") @db.VarChar(255)
  entorno                  String?  @db.VarChar(20)
  webhookUrl               String?  @map("webhook_url") @db.VarChar(500)
  plan                     String?  @db.VarChar(50)
  taxRegime                String?  @map("tax_regime") @db.VarChar(50)
  sireLastPeriodSynced     String?  @map("sire_last_period_synced") @db.VarChar(10)
  sireClientId             String?  @map("sire_client_id") @db.VarChar(255)
  sireClientSecret         String?  @map("sire_client_secret") @db.VarChar(255)
  activo                   Boolean?
  tieneCertificado         Boolean? @map("tiene_certificado")
  creadoEn                 String?  @map("creado_en") @db.VarChar(30)
  seriesConfigJson         Json?    @map("series_config")
  /// Número de Registro MTC (empresas de transporte / GRE pública). Ej: 1588035CNG
  nroMtc                   String?  @map("nro_mtc") @db.VarChar(40)

  usuarios Usuario[]

  @@unique([ruc])
  @@map("companies")
}

model Usuario {
  id           Int           @id @default(autoincrement())
  email        String        @unique @db.VarChar(255)
  contrasena   String        @db.VarChar(255)
  token        String?       @db.Text
  refreshToken String?       @map("refresh_token") @db.Text
  lastUpdated  BigInt        @map("last_updated")
  estado       EstadoUsuario @default(ACTIVO)
  rol          RolUsuario    @default(USUARIO)
  companyId    BigInt?       @map("company_id")
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  almacenId    String?       @map("almacen_id") @db.VarChar(36)
  almacen      Almacen?      @relation(fields: [almacenId], references: [id], onDelete: SetNull)
  movimientos  Movimiento[]

  @@index([almacenId])
  @@map("usuarios")
}

enum SaleDetailEstado {
  ACTIVO
  DEVUELTO
  ACREDITADO
}

model SaleDetail {
  id                String   @id @default(uuid()) @db.VarChar(36)
  invoiceId         String?  @map("invoice_id") @db.VarChar(36)
  catalogItemId     String?  @map("catalog_item_id") @db.VarChar(64)
  /// Código del vendedor / interno en el CPE (no confundir con UNSPSC).
  codigo            String?  @db.VarChar(64)
  /// Código producto SUNAT (UNSPSC Cat. 25) del CPE.
  codigoSunat       String?  @map("codigo_sunat") @db.VarChar(32)
  descripcion       String?  @db.VarChar(500)
  nombre            String?  @db.VarChar(255)
  cantidad          Decimal  @db.Decimal(14, 4)
  unidad            String?  @default("NIU") @db.VarChar(10)
  mtoPrecioUnitario Decimal? @map("mto_precio_unitario") @db.Decimal(14, 4)
  tipAfeIgv         String   @default("10") @map("tip_afe_igv") @db.VarChar(4)
  mtoValorVenta     Decimal? @map("mto_valor_venta") @db.Decimal(14, 4)
  mtoIgv            Decimal? @map("mto_igv") @db.Decimal(14, 4)
  totalFactura      Decimal? @map("total") @db.Decimal(14, 4)
  mtoValorUnitario  Decimal? @map("mto_valor_unitario") @db.Decimal(14, 4)
  mtoBaseIgv        Decimal? @map("mto_base_igv") @db.Decimal(14, 4)
  porcentajeIgv     Decimal? @map("porcentaje_igv") @db.Decimal(6, 2)
  productoSerieId   String?  @map("producto_serie_id") @db.VarChar(36)
  /// Si tiene valor, la línea participa en movimiento de inventario de ese almacén.
  /// Null = digitada / solo referencia (no afecta stock).
  almacenId         String?  @map("almacen_id") @db.VarChar(36)
  estado            SaleDetailEstado @default(ACTIVO)
  productoSerie     ProductoSerie? @relation(fields: [productoSerieId], references: [id], onDelete: SetNull)
  catalogItem       CatalogItem?   @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  invoice           Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  almacen           Almacen?       @relation(fields: [almacenId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productoSerieId])
  @@index([catalogItemId])
  @@index([codigoSunat])
  @@index([estado])
  @@index([almacenId])
  @@map("sale_details")
}

enum ProductoSerieEstado {
  DISPONIBLE
  RESERVADO
  VENDIDO
  ENTREGADO
  BAJA
}

model ProductoSerie {
  id            String              @id @db.VarChar(36)
  companyRuc    String              @map("company_ruc") @db.VarChar(11)
  catalogItemId String              @map("catalog_item_id") @db.VarChar(64)
  numeroSerie   String              @map("numero_serie") @db.VarChar(100)
  almacenId     String?             @map("almacen_id") @db.VarChar(36)
  estado        ProductoSerieEstado
  comprobanteId String?             @map("comprobante_id") @db.VarChar(36)
  entregaId     String?             @map("entrega_id") @db.VarChar(36)
  saleDetails   SaleDetail[]
  lineasCatalogo LineaCatalogoItem[]
  inventario     Inventario?
  ordenDetalles  OrdenDetalle[]
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  comprobante   Invoice?    @relation(fields: [comprobanteId], references: [id], onDelete: SetNull)
  almacen       Almacen?    @relation(fields: [almacenId], references: [id], onDelete: SetNull)

  @@unique([companyRuc, numeroSerie])
  @@index([catalogItemId])
  @@index([almacenId])
  @@map("producto_series")
}

enum MovimientoTipo {
  ENTRADA
  SALIDA
  AJUSTE
}

enum MovimientoEstado {
  BORRADOR
  EN_CAMINO
  DESPACHADA
  ANULADA
}

/// Historial de entradas, salidas y traslados. No calcula stock:
/// el saldo vivo está en [Inventario] y se actualiza al confirmar cada operación.
model Movimiento {
  id               String            @id @db.VarChar(36)
  companyRuc       String            @map("company_ruc") @db.VarChar(11)
  almacenId        String            @map("almacen_id") @db.VarChar(36)
  tipo             MovimientoTipo
  fecha            String            @db.VarChar(30)
  observaciones    String?           @db.Text
  referenciaTipo   String?           @map("referencia_tipo") @db.VarChar(50)
  referenciaId     String?           @map("referencia_id") @db.VarChar(36)
  numero           String?           @db.VarChar(50)
  almacenDestinoId String?           @map("almacen_destino_id") @db.VarChar(36)
  estado           MovimientoEstado?
  comprobanteId    String?           @map("comprobante_id") @db.VarChar(36)
  guiaRemisionId   String?           @map("guia_remision_id") @db.VarChar(36)
  fechaDespacho    String?           @map("fecha_despacho") @db.VarChar(30)
  clienteId        String?           @map("cliente_id") @db.VarChar(36)
  usuarioId        Int?              @map("usuario_id")
  lineas           LineaCatalogoItem[]
  comprobante      Invoice?          @relation("MovimientoComprobante", fields: [comprobanteId], references: [id], onDelete: SetNull)
  guiaRemision     Invoice?          @relation("MovimientoGuiaRemision", fields: [guiaRemisionId], references: [id], onDelete: SetNull)
  almacen          Almacen           @relation("MovimientoAlmacenOrigen", fields: [almacenId], references: [id])
  almacenDestino   Almacen?          @relation("MovimientoAlmacenDestino", fields: [almacenDestinoId], references: [id], onDelete: SetNull)
  cliente          Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  usuario          Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([companyRuc])
  @@index([almacenId])
  @@index([almacenDestinoId])
  @@index([comprobanteId])
  @@index([clienteId])
  @@index([usuarioId])
  @@map("movimientos")
}

model LineaCatalogoItem {
  lineaId         String   @id @default(uuid()) @map("linea_id") @db.VarChar(36)
  movimientoId    String   @map("movimiento_id") @db.VarChar(36)
  catalogItemId   String   @map("catalog_item_id") @db.VarChar(64)
  nombre          String?  @db.VarChar(255)
  codigo          String?  @db.VarChar(64)
  descripcion     String?  @db.VarChar(500)
  unidad          String?  @db.VarChar(10)
  precioUnitario  Decimal? @map("precio_unitario") @db.Decimal(14, 4)
  afectacionIgv   String?  @map("afectacion_igv") @db.VarChar(4)
  kind            String?  @db.VarChar(50)
  manejaStock     Boolean? @map("maneja_stock")
  manejaSerie     Boolean? @map("maneja_serie")
  cantidad        Decimal  @db.Decimal(14, 4)
  almacenId       String?  @map("almacen_id") @db.VarChar(36)
  productoSerieId String?  @map("producto_serie_id") @db.VarChar(36)

  movimiento    Movimiento     @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  productoSerie ProductoSerie? @relation(fields: [productoSerieId], references: [id], onDelete: SetNull)
  catalogItem   CatalogItem    @relation(fields: [catalogItemId], references: [id])
  almacen       Almacen?       @relation(fields: [almacenId], references: [id], onDelete: SetNull)

  @@index([movimientoId])
  @@index([catalogItemId])
  @@index([productoSerieId])
  @@index([almacenId])
  @@map("linea_catalogo_items")
}

enum CatalogItemKind {
  PRODUCT
  SERVICE
}

model CatalogItem {
  id              String          @id @db.VarChar(36)
  companyRuc      String          @map("company_ruc") @db.VarChar(11)
  kind            CatalogItemKind
  codigo          String?  @db.VarChar(64)
  /// Código estandarizado SUNAT (p. ej. UNSPSC / clasificador de bienes y servicios).
  codigoSunat     String?  @map("codigo_sunat") @db.VarChar(32)
  nombre          String   @db.VarChar(255)
  descripcion     String?  @db.VarChar(500)
  unidad          String   @db.VarChar(10)
  precioUnitario  Decimal  @map("precio_unitario") @db.Decimal(14, 4)
  /// Costo de adquisición. Vacío si aún no se registró.
  precioCompra    Decimal? @map("precio_compra") @db.Decimal(14, 4)
  /// YYYY-MM-DD. Solo productos que vencen; null en el resto.
  fechaVencimiento String? @map("fecha_vencimiento") @db.VarChar(10)
  /// Código de lote del producto. Vacío si no aplica.
  lote            String?  @db.VarChar(64)
  afectacionIgv   String   @default("10") @map("afectacion_igv") @db.VarChar(4)
  activo          Boolean  @default(true)
  manejaStock     Boolean  @default(false) @map("maneja_stock")
  manejaSerie     Boolean  @default(false) @map("maneja_serie")
  stockActual     Decimal? @map("stock_actual") @db.Decimal(14, 4)
  duracionMinutos Int?     @map("duracion_minutos")

  productoSeries ProductoSerie[]
  lineasCatalogo LineaCatalogoItem[]
  saleDetails    SaleDetail[]
  inventario     Inventario[]
  ordenDetalles  OrdenDetalle[]

  @@index([companyRuc])
  @@index([companyRuc, codigo])
  @@map("catalog_items")
}

/// Fuente de verdad del stock por almacén (saldo actual).
/// - Saldo por cantidad: `saldoKey` = catalogItemId:almacenId, `productoSerieId` null.
/// - Unidad serializada: una fila por serie (`productoSerieId` único, cantidad = 1).
/// [Movimiento] y [LineaCatalogoItem] solo registran historial; no se suman para consultar stock.
model Inventario {
  id              String   @id @default(uuid()) @db.VarChar(36)
  companyRuc      String   @map("company_ruc") @db.VarChar(11)
  catalogItemId   String   @map("catalog_item_id") @db.VarChar(36)
  almacenId       String   @map("almacen_id") @db.VarChar(36)
  productoSerieId String?  @unique @map("producto_serie_id") @db.VarChar(36)
  saldoKey        String?  @unique @map("saldo_key") @db.VarChar(110)
  cantidad        Decimal  @db.Decimal(14, 4)

  catalogItem   CatalogItem    @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  almacen       Almacen        @relation(fields: [almacenId], references: [id], onDelete: Cascade)
  productoSerie ProductoSerie? @relation(fields: [productoSerieId], references: [id], onDelete: Cascade)

  @@index([catalogItemId, almacenId])
  @@index([companyRuc])
  @@index([almacenId])
  @@map("inventario")
}

model Legend {
  id        String   @id @default(uuid()) @db.VarChar(36)
  invoiceId String?  @map("invoice_id") @db.VarChar(36)
  code      String   @db.VarChar(10)
  value     String   @db.Text
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("legends")
}

enum ComprobanteEstado {
  BORRADOR
  ENVIADO
  ACEPTADO
  RECHAZADO
  ANULADO
}

model Cliente {
  id          String  @id @db.VarChar(36)
  companyRuc  String  @map("company_ruc") @db.VarChar(11)
  tipoDoc     String  @map("tipo_doc") @db.VarChar(2)
  numeroDoc   String  @map("numero_doc") @db.VarChar(20)
  razonSocial String   @map("razon_social") @db.VarChar(255)
  /// Snapshot de dirección del cliente (JSON). Catálogo reciente = tabla addresses.
  addressJson Json?    @map("address_json")
  telefono    String?  @db.VarChar(30)
  activo      Boolean @default(true)
  invoices    Invoice[]
  movimientos Movimiento[]
  ordenes     Orden[]

  @@unique([companyRuc, tipoDoc, numeroDoc])
  @@index([companyRuc])
  @@map("clientes")
}

/// Catálogo de ubicaciones reutilizables (picker GRE / órdenes).
/// Las entidades (cliente, almacén, empresa, orden) guardan su propio snapshot JSON.
model Address {
  id           String    @id @default(uuid()) @db.VarChar(36)
  ubigeo       String?   @db.VarChar(6)
  departamento String?   @db.VarChar(100)
  provincia    String?   @db.VarChar(100)
  distrito     String?   @db.VarChar(100)
  urbanizacion String?   @db.VarChar(100)
  direccion    String?   @db.VarChar(500)
  codLocal     String?   @default("0000") @map("cod_local") @db.VarChar(4)
  companyRuc   String?   @map("company_ruc") @db.VarChar(11)
  etiqueta     String?   @db.VarChar(120)
  creadoEn     DateTime? @default(now()) @map("creado_en")

  @@index([companyRuc])
  @@map("addresses")
}

/// Catálogo SUNAT 13 / INEI: departamento (código de 2 dígitos).
model Region {
  codigo     String      @id @db.Char(2)
  nombre     String      @db.VarChar(80)
  provincias Provincia[]

  @@map("regiones")
}

/// Provincia INEI: código = región(2) + provincia(2).
model Provincia {
  codigo       String     @id @db.Char(4)
  codigoLocal  String     @map("codigo_local") @db.Char(2)
  nombre       String     @db.VarChar(100)
  regionCodigo String     @map("region_codigo") @db.Char(2)
  region       Region     @relation(fields: [regionCodigo], references: [codigo], onDelete: Restrict)
  distritos    Distrito[]

  @@index([regionCodigo])
  @@map("provincias")
}

/// Distrito INEI: código = ubigeo completo (6 dígitos) = región + provincia + distrito.
model Distrito {
  codigo          String    @id @db.Char(6)
  codigoLocal     String    @map("codigo_local") @db.Char(2)
  nombre          String    @db.VarChar(120)
  provinciaCodigo String    @map("provincia_codigo") @db.Char(4)
  provincia       Provincia @relation(fields: [provinciaCodigo], references: [codigo], onDelete: Restrict)

  @@index([provinciaCodigo])
  @@map("distritos")
}

/// Vehículo de la empresa (flota GRE).
/// permisos: lista JSON [{ "tipo": "TUCE", "numero": "15M..." }, ...]
model Vehiculo {
  id         String @id @default(uuid()) @db.VarChar(36)
  companyRuc String @map("company_ruc") @db.VarChar(11)
  placa      String @db.VarChar(15)
  permisos   Json   @default("[]")

  @@unique([companyRuc, placa])
  @@index([companyRuc])
  @@map("vehiculos")
}

/// Conductor de la empresa (flota GRE).
model Conductor {
  id               String  @id @default(uuid()) @db.VarChar(36)
  companyRuc       String  @map("company_ruc") @db.VarChar(11)
  tipoDoc          String  @default("1") @map("tipo_doc") @db.VarChar(2)
  numeroDoc        String  @map("numero_doc") @db.VarChar(20)
  nombresCompletos String  @map("nombres_completos") @db.VarChar(255)
  licencia         String? @db.VarChar(40)

  @@unique([companyRuc, tipoDoc, numeroDoc])
  @@index([companyRuc])
  @@index([numeroDoc])
  @@map("conductores")
}

/// Empresa transportista (cat. público GRE) — tabla sola, sin relaciones.
model Transportista {
  id          String  @id @default(uuid()) @db.VarChar(36)
  ruc         String  @unique @db.VarChar(11)
  razonSocial String  @map("razon_social") @db.VarChar(255)
  nroMtc      String? @map("nro_mtc") @db.VarChar(40)

  @@index([razonSocial])
  @@map("transportistas")
}

model Almacen {
  id                 String   @id @db.VarChar(36)
  companyRuc         String   @map("company_ruc") @db.VarChar(11)
  codigo             String   @db.VarChar(32)
  nombre             String   @db.VarChar(255)
  /// Snapshot de dirección del almacén (JSON).
  addressJson        Json?    @map("address_json")
  activo             Boolean  @default(true)

  productoSeries     ProductoSerie[]
  movimientosOrigen  Movimiento[]      @relation("MovimientoAlmacenOrigen")
  movimientosDestino Movimiento[]      @relation("MovimientoAlmacenDestino")
  lineasCatalogo     LineaCatalogoItem[]
  usuarios           Usuario[]
  inventario         Inventario[]
  invoices           Invoice[]
  ordenDetalles      OrdenDetalle[]
  saleDetails        SaleDetail[]

  @@unique([companyRuc, codigo])
  @@index([companyRuc])
  @@map("almacenes")
}

model Invoice {
  id                      String            @id @db.VarChar(36)
  companyRuc              String            @default("") @map("company_ruc") @db.VarChar(11)
  ublVersion              String            @default("2.1") @map("ubl_version") @db.VarChar(10)
  tipoOperacion           String            @default("0101") @map("tipo_operacion") @db.VarChar(10)
  tipoDoc                 String            @map("tipo_doc") @db.VarChar(4)
  serie                   String            @db.VarChar(10)
  correlativo             String            @db.VarChar(20)
  fechaEmision            String?           @map("fecha_emision") @db.VarChar(30)
  fecVencimiento          String?           @map("fec_vencimiento") @db.VarChar(30)
  tipoMoneda              String            @default("PEN") @map("tipo_moneda") @db.VarChar(3)
  formaPago               String?           @map("forma_pago") @db.VarChar(50)
  /// Medio de cobro elegido al emitir (Yape, CCI, etc.).
  metodoPagoId            String?           @map("metodo_pago_id") @db.VarChar(36)
  observacion             String?           @db.Text
  mtoOperGravadas         Decimal?          @map("mto_oper_gravadas") @db.Decimal(14, 4)
  mtoOperExoneradas       Decimal?          @map("mto_oper_exoneradas") @db.Decimal(14, 4)
  mtoOperInafectas        Decimal?          @map("mto_oper_inafectas") @db.Decimal(14, 4)
  mtoOperExportacion      Decimal?          @map("mto_oper_exportacion") @db.Decimal(14, 4)
  mtoIgv                  Decimal?          @map("mto_igv") @db.Decimal(14, 4)
  totalImpuestos          Decimal?          @map("total_impuestos") @db.Decimal(14, 4)
  subTotal                Decimal?          @map("sub_total") @db.Decimal(14, 4)
  mtoImpVenta             Decimal?          @map("mto_imp_venta") @db.Decimal(14, 4)
  /// Almacén de salida al emitir factura/boleta (inventario post-venta).
  almacenId               String?           @map("almacen_id") @db.VarChar(36)
  /// Solo guías 09/31: envío (partida/llegada, vehículo[+secundarios], conductor[+secundarios]).
  guiaMetaJson            Json?             @map("guia_meta")
  motivoCodigo            String?           @map("motivo_codigo") @db.VarChar(10)
  motivoNota              String?           @map("motivo_nota") @db.VarChar(255)
  documentoAfectadoId     String?           @map("documento_afectado_id") @db.VarChar(36)
  estado                  ComprobanteEstado @default(BORRADOR)
  cdrEstado               String?           @map("cdr_estado") @db.VarChar(50)
  pdfUrl                  String?           @map("pdf_url") @db.VarChar(500)
  cdrZipUrl               String?           @map("cdr_zip_url") @db.VarChar(500)
  xmlUrlDirecto           String?           @map("xml_url") @db.VarChar(500)
  /// Adjuntos de usuario (clave → { url, nombre, content_type, size }). Clave = key R2.
  archivosJson            Json?             @map("archivos")
  sunatEstadoDirecto      String?           @map("sunat_estado") @db.VarChar(50)
  sunatCodigoDirecto      String?           @map("sunat_codigo") @db.VarChar(20)
  sunatDescripcionDirecto   String?           @map("sunat_descripcion") @db.Text
  sunatNotasDirecto       Json?             @map("sunat_notas")
  hash                    String?           @map("hash_cpe") @db.VarChar(128)
  sunatJson               Json?             @map("sunat")
  clienteId               String?           @map("cliente_id") @db.VarChar(36)

  cliente                 Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  almacen                 Almacen?          @relation(fields: [almacenId], references: [id], onDelete: SetNull)
  metodoPago              MetodoPago?       @relation(fields: [metodoPagoId], references: [id], onDelete: SetNull)
  documentoAfectado       Invoice?          @relation("DocumentoAfectado", fields: [documentoAfectadoId], references: [id], onDelete: SetNull)
  notasQueAfectan         Invoice[]         @relation("DocumentoAfectado")
  details                 SaleDetail[]
  legends                 Legend[]
  productoSeries          ProductoSerie[]
  movimientosComprobante  Movimiento[]      @relation("MovimientoComprobante")
  movimientosGuiaRemision Movimiento[]      @relation("MovimientoGuiaRemision")
  /// GRE / CPE → CPEs relacionados (emitidos o recibidos).
  lineInvoices         LineInvoiceInvoice[] @relation("LineInvoicePrincipal")
  referenciadoEnLineas LineInvoiceInvoice[] @relation("LineInvoiceRelacionado")
  /// Pedido de la app que originó o quedó ligado a este comprobante (0..1).
  orden                Orden?

  @@unique([companyRuc, tipoDoc, serie, correlativo])
  @@index([companyRuc])
  @@index([tipoDoc])
  @@index([documentoAfectadoId])
  @@index([clienteId])
  @@index([almacenId])
  @@index([metodoPagoId])
  @@map("invoices")
}

/// Medios de cobro de la empresa (Yape, CCI, Plin…) para factura/boleta.
model MetodoPago {
  id            String   @id @db.VarChar(36)
  companyRuc    String   @map("company_ruc") @db.VarChar(11)
  /// Nombre visible: "Yape Raymi", "BCP CCI".
  nombre        String   @db.VarChar(120)
  /// Canal: YAPE | CCI | PLIN | TRANSFERENCIA | EFECTIVO | OTRO.
  tipo          String   @db.VarChar(30)
  /// Celular Yape/Plin o número CCI.
  valor         String   @db.VarChar(80)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  invoices Invoice[]

  @@index([companyRuc])
  @@index([companyRuc, activo])
  @@map("metodos_pago")
}

/// Enlace invoice ↔ invoice relacionado (p. ej. GRE → factura emitida/recibida).
model LineInvoiceInvoice {
  id         String   @id @db.VarChar(36)
  /// Documento principal (p. ej. la GRE).
  invoiceId  String   @map("invoice_id") @db.VarChar(36)
  /// CPE relacionado (emitido por ti o recibido de un proveedor).
  invoice2Id String   @map("invoice2_id") @db.VarChar(36)
  orden      Int      @default(0)
  creadoEn   DateTime @default(now()) @map("creado_en")

  invoice  Invoice @relation("LineInvoicePrincipal", fields: [invoiceId], references: [id], onDelete: Cascade)
  invoice2 Invoice @relation("LineInvoiceRelacionado", fields: [invoice2Id], references: [id], onDelete: Cascade)

  @@unique([invoiceId, invoice2Id], map: "line_inv_inv_unique")
  @@index([invoiceId], map: "line_inv_inv_invoice_idx")
  @@index([invoice2Id], map: "line_inv_inv_invoice2_idx")
  @@map("line_invoice_invoice")
}

/// Documentos externos recibidos (facturas/GRE de proveedores, OCR, SIRE, scraper SOL).
/// Misma idea que Invoice (cabecera + detalle) pero aislado de la emisión:
///  - líneas del proveedor → columna `lineas` (JSON), sin SaleDetail
///  - GRE / docs relacionados → columna `guia_meta` (JSON), sin line_invoice_invoice
///  - catálogo solo si el usuario relaciona una línea manualmente (catalog_item_id en JSON)
/// Tus comprobantes emitidos viven en `invoices`, no aquí.
model Compra {
  id                    String   @id @db.VarChar(36)
  /// Tu RUC (receptor / adquiriente).
  companyRuc            String   @map("company_ruc") @db.VarChar(11)
  tipoDoc               String   @default("01") @map("tipo_doc") @db.VarChar(4)
  serie                 String   @db.VarChar(10)
  correlativo           String   @db.VarChar(20)
  fechaEmision          String?  @map("fecha_emision") @db.VarChar(30)
  tipoMoneda            String   @default("PEN") @map("tipo_moneda") @db.VarChar(3)
  proveedorTipoDoc      String   @default("6") @map("proveedor_tipo_doc") @db.VarChar(2)
  proveedorNumeroDoc    String   @map("proveedor_numero_doc") @db.VarChar(15)
  proveedorRazonSocial  String   @map("proveedor_razon_social") @db.VarChar(255)
  subTotal              Decimal? @map("sub_total") @db.Decimal(14, 4)
  mtoIgv                Decimal? @map("mto_igv") @db.Decimal(14, 4)
  mtoImpVenta           Decimal? @map("mto_imp_venta") @db.Decimal(14, 4)
  /// Líneas del proveedor (JSON): descripción, cantidad, unidad, precio. catalog_item_id solo si el usuario relacionó manualmente al ingresar.
  lineasJson            Json     @map("lineas")
  /// OCR | SIRE_RCE | SIRE_SSPP | SSPP | XML_MANUAL
  origen                String   @default("OCR") @db.VarChar(20)
  /// Fuente detallada SUNAT (sire_rce, sire_sspp, sspp, xml_manual).
  fuente                String?  @db.VarChar(30)
  estado                String?  @default("ACEPTADO") @db.VarChar(30)
  imagenUrl             String?  @map("imagen_url") @db.VarChar(500)
  xmlUrl                String?  @map("xml_url") @db.VarChar(500)
  pdfUrl                String?  @map("pdf_url") @db.VarChar(500)
  hashCpe               String?  @map("hash_cpe") @db.VarChar(128)
  guiaMetaJson          Json?    @map("guia_meta")
  /// GRE: envío, destinatario, transportista, documentos_relacionados (JSON, refs externas sin FK).
  observacion           String?  @db.Text
  creadoEn              DateTime @default(now()) @map("creado_en")
  actualizadoEn         DateTime @updatedAt @map("actualizado_en")

  @@unique([companyRuc, tipoDoc, serie, correlativo, proveedorNumeroDoc])
  @@index([companyRuc])
  @@index([proveedorNumeroDoc])
  @@index([companyRuc, fechaEmision])
  @@index([fuente])
  @@map("compras")
}

enum OrdenEstado {
  BORRADOR
  CONFIRMADA
  FACTURADA
  ANULADA
}

/// Pedido / orden de la app (antes o además del comprobante).
/// Relacionada a un [Cliente] y, cuando se factura, a un [Invoice].
model Orden {
  id              String      @id @db.VarChar(36)
  companyRuc      String      @map("company_ruc") @db.VarChar(11)
  clienteId       String      @map("cliente_id") @db.VarChar(36)
  /// Comprobante emitido a partir de esta orden (opcional hasta facturar).
  invoiceId       String?     @unique @map("invoice_id") @db.VarChar(36)
  /// Snapshot JSON de la dirección de envío (ubigeo, distrito, mz/lote…).
  addressEnvio    Json?       @map("address_envio")
  estado          OrdenEstado @default(BORRADOR)
  tipoMoneda      String      @default("PEN") @map("tipo_moneda") @db.VarChar(3)
  observacion     String?     @db.Text
  mtoOperGravadas Decimal?    @map("mto_oper_gravadas") @db.Decimal(14, 4)
  mtoIgv          Decimal?    @map("mto_igv") @db.Decimal(14, 4)
  subTotal        Decimal?    @map("sub_total") @db.Decimal(14, 4)
  mtoImpVenta     Decimal?    @map("mto_imp_venta") @db.Decimal(14, 4)
  /// False hasta que alguien abra la orden (badge / notificación).
  visto           Boolean     @default(false)
  creadoEn        DateTime    @default(now()) @map("creado_en")
  actualizadoEn   DateTime    @updatedAt @map("actualizado_en")

  cliente      Cliente        @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  invoice      Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  detalles     OrdenDetalle[]

  @@index([companyRuc])
  @@index([clienteId])
  @@index([estado])
  @@index([companyRuc, creadoEn])
  @@map("ordenes")
}

/// Línea de producto de una [Orden] (mismo patrón de precios que [SaleDetail]).
model OrdenDetalle {
  id                String  @id @default(uuid()) @db.VarChar(36)
  ordenId           String  @map("orden_id") @db.VarChar(36)
  catalogItemId     String? @map("catalog_item_id") @db.VarChar(64)
  /// Orden de la línea en el pedido (1-based).
  ordenLinea        Int     @default(0) @map("orden_linea")
  codigo            String? @db.VarChar(64)
  codigoSunat       String? @map("codigo_sunat") @db.VarChar(32)
  descripcion       String? @db.VarChar(500)
  nombre            String? @db.VarChar(255)
  cantidad          Decimal @db.Decimal(14, 4)
  unidad            String? @default("NIU") @db.VarChar(10)
  mtoPrecioUnitario Decimal? @map("mto_precio_unitario") @db.Decimal(14, 4)
  tipAfeIgv         String  @default("10") @map("tip_afe_igv") @db.VarChar(4)
  mtoValorUnitario  Decimal? @map("mto_valor_unitario") @db.Decimal(14, 4)
  mtoValorVenta     Decimal? @map("mto_valor_venta") @db.Decimal(14, 4)
  mtoBaseIgv        Decimal? @map("mto_base_igv") @db.Decimal(14, 4)
  mtoIgv            Decimal? @map("mto_igv") @db.Decimal(14, 4)
  porcentajeIgv     Decimal? @map("porcentaje_igv") @db.Decimal(6, 2)
  total             Decimal? @map("total") @db.Decimal(14, 4)
  almacenId         String?  @map("almacen_id") @db.VarChar(36)
  /// Serie física reservada / elegida en la orden (NIU con maneja_serie).
  productoSerieId   String?  @map("producto_serie_id") @db.VarChar(36)

  orden         Orden         @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  almacen       Almacen?      @relation(fields: [almacenId], references: [id], onDelete: SetNull)
  productoSerie ProductoSerie? @relation(fields: [productoSerieId], references: [id], onDelete: SetNull)

  @@index([ordenId])
  @@index([catalogItemId])
  @@index([almacenId])
  @@index([productoSerieId])
  @@map("orden_detalles")
}

/// Configuración global de la app móvil (una sola fila, id = 1).
/// Editable desde el panel web; la app la consulta al iniciar o al refrescar.
model Configuracion {
  id                      Int     @id @default(1)
  nombreApp               String  @default("FactApp") @map("nombre_app") @db.VarChar(120)
  nombreDesarrollador     String  @default("") @map("nombre_desarrollador") @db.VarChar(255)
  telefonosSoporte        Json?   @map("telefonos_soporte")
  whatsappSoporte         String? @map("whatsapp_soporte") @db.VarChar(20)
  emailSoporte            String? @map("email_soporte") @db.VarChar(255)
  horarioSoporte          String? @map("horario_soporte") @db.VarChar(120)
  urlActualizacion        String? @map("url_actualizacion") @db.VarChar(500)
  urlActualizacionApk     String? @map("url_actualizacion_apk") @db.VarChar(500)
  versionActual           String? @map("version_actual") @db.VarChar(20)
  versionMinima           String? @map("version_minima") @db.VarChar(20)
  notasRelease            String? @map("notas_release") @db.Text
  /// Si true, la app móvil bloquea el acceso y obliga ir a Play Store.
  actualizar              Boolean @default(false)
  mantenimientoActivo     Boolean @default(false) @map("mantenimiento_activo")
  mensajeMantenimiento    String? @map("mensaje_mantenimiento") @db.Text
  urlTerminos             String? @map("url_terminos") @db.VarChar(500)
  urlPrivacidad           String? @map("url_privacidad") @db.VarChar(500)
  urlSitioWeb             String? @map("url_sitio_web") @db.VarChar(500)
  urlLogo                 String? @map("url_logo") @db.VarChar(500)
  mensajeBienvenida       String? @map("mensaje_bienvenida") @db.Text
  redesSociales           Json?   @map("redes_sociales")
  actualizadoEn           String? @map("actualizado_en") @db.VarChar(30)

  @@map("configuracion")
}

/// Catálogo N° 25 SUNAT — códigos UNSPSC v14_0801 (español).
model CodigoProductoSunat {
  codigo String @id @db.VarChar(8)
  nombre String @db.VarChar(255)

  @@index([nombre])
  @@map("codigo_producto_sunat")
}

/// Tipos de operación SUNAT con detracción (1001 a 1004).
/// codigos: menú de bien/servicio. campos: datos extra que pide ese tipo.
model Detraccion {
  codigo  String @id @db.VarChar(4)
  nombre  String @db.VarChar(240)
  codigos Json
  campos  Json
  orden   Int    @default(0)

  @@map("detracciones")
}
