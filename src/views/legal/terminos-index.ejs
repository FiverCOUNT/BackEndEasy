<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="legal-page">
  <header class="legal-header">
    <div class="legal-header-inner">
      <p class="legal-eyebrow">Documentos legales</p>
      <h1>Términos y condiciones</h1>
      <p class="legal-lead">Selecciona la aplicación.</p>
    </div>
  </header>

  <main class="legal-container">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash flash-error" role="alert"><%= error %></div>
    <% } %>

    <section class="legal-chooser">
      <% apps.forEach(function(app) { %>
        <a class="legal-chooser-card legal-chooser-card--<%= app.slug %>" href="/terminosycondiciones/<%= app.slug %>">
          <strong><%= app.marca %></strong>
          <span><%= app.blurb %></span>
          <em>Leer términos</em>
        </a>
      <% }); %>
    </section>
  </main>

  <footer class="legal-footer">
    <p>Documentos públicos · no requieren inicio de sesión</p>
  </footer>
</body>
</html>
