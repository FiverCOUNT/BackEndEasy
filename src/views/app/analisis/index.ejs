<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · Easy</title>
  <link rel="stylesheet" href="/css/app-ios.css?v=analisis-alm-bar" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js" defer></script>
</head>
<body class="ios-app">
  <%- include('../../partials/app-nav', { active: active, navItems: navItems, webUser: webUser, appBase: appBase }) %>

  <main class="ios-main">
    <header class="ios-top">
      <div>
        <p class="ios-eyebrow"><%= companyNombre || 'Empresa' %></p>
        <h1>Análisis</h1>
      </div>
    </header>

    <form class="ios-filters ios-analisis-filters" method="GET" action="<%= appBase %>/analisis">
      <div class="ios-filter-row ios-analisis-filter-row is-almacen">
        <select name="periodo" class="ios-select" aria-label="Periodo" onchange="this.form.submit()">
          <option value="hoy" <%= filtros.periodo === 'hoy' ? 'selected' : '' %>>Hoy</option>
          <option value="7d" <%= filtros.periodo === '7d' ? 'selected' : '' %>>7 días</option>
          <option value="30d" <%= filtros.periodo === '30d' ? 'selected' : '' %>>30 días</option>
          <option value="mes" <%= filtros.periodo === 'mes' ? 'selected' : '' %>>Este mes</option>
          <option value="mes_ant" <%= filtros.periodo === 'mes_ant' ? 'selected' : '' %>>Mes anterior</option>
          <option value="trimestre" <%= filtros.periodo === 'trimestre' ? 'selected' : '' %>>Último trimestre</option>
          <option value="anio" <%= filtros.periodo === 'anio' ? 'selected' : '' %>>Este año</option>
        </select>
        <select name="almacen" class="ios-select" aria-label="Almacén / tienda" onchange="this.form.submit()">
          <option value="" <%= !filtros.almacen ? 'selected' : '' %>>Todos los almacenes</option>
          <% (almacenes || []).forEach(function(a) { %>
            <option value="<%= a.id %>" <%= filtros.almacen === a.id ? 'selected' : '' %>>
              <%= a.nombre %><%= a.codigo ? ' (' + a.codigo + ')' : '' %>
            </option>
          <% }); %>
        </select>
        <select name="vista" class="ios-select" aria-label="Ranking" onchange="this.form.submit()">
          <option value="vendidos" <%= (filtros.vista || filtros.orden) === 'vendidos' || filtros.orden === 'unidades' ? 'selected' : '' %>>Más vendidos</option>
          <option value="ingresos" <%= (filtros.vista || filtros.orden) === 'ingresos' || filtros.orden === 'venta' ? 'selected' : '' %>>Más ingresos</option>
        </select>
        <select name="top" class="ios-select" aria-label="Top" onchange="this.form.submit()">
          <option value="10" <%= Number(filtros.top) === 10 ? 'selected' : '' %>>Top 10</option>
          <option value="20" <%= Number(filtros.top) === 20 ? 'selected' : '' %>>Top 20</option>
        </select>
      </div>
      <input type="hidden" name="solo_costo" value="0" />
      <input type="hidden" name="desde" value="<%= filtros.desde %>" />
      <input type="hidden" name="hasta" value="<%= filtros.hasta %>" />
      <p class="ios-hint"><%= filtros.desde %> → <%= filtros.hasta %><% if (filtros.almacen) { %> · una tienda<% } else { %> · todas las tiendas<% } %></p>
    </form>

    <section class="ios-analisis-kpis is-3">
      <article class="ios-analisis-kpi">
        <span>Ventas</span>
        <strong>S/ <%= Number(kpis.venta || 0).toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
      </article>
      <article class="ios-analisis-kpi is-ok">
        <span>Margen</span>
        <strong>S/ <%= Number(kpis.margen || 0).toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
        <small><%= kpis.margen_pct %>%</small>
      </article>
      <article class="ios-analisis-kpi">
        <span>Cantidad vendida</span>
        <strong><%= Number(kpis.unidades || 0).toLocaleString('es-PE') %></strong>
      </article>
    </section>

    <% if (!(charts && ((charts.top_unidades || []).length || (charts.top_venta || []).length))) { %>
      <section class="ios-card-empty">
        <div class="ios-empty-icon">◈</div>
        <h2>Sin ventas en este periodo</h2>
        <p>Cuando emitas facturas o boletas verás los gráficos aquí.</p>
      </section>
    <% } else { %>
      <%
        var rankingAlm = (!filtros.almacen && charts && charts.por_almacen) ? charts.por_almacen : [];
        var topAlm = rankingAlm.length ? rankingAlm[0] : null;
      %>
      <% if (rankingAlm.length) { %>
      <section class="ios-analisis-alm-block">
        <div class="ios-analisis-alm-head">
          <div>
            <h2>Ventas por almacén</h2>
            <p>Comparación de ingresos generados por cada tienda.</p>
          </div>
          <% if (topAlm && Number(topAlm.venta) > 0) { %>
          <div class="ios-analisis-alm-winner">
            <span>Más genera</span>
            <strong><%= topAlm.nombre %></strong>
            <small>S/ <%= Number(topAlm.venta || 0).toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></small>
          </div>
          <% } %>
        </div>
        <article class="ios-analisis-chart-card is-wide is-alm">
          <div class="ios-analisis-chart-canvas is-h-alm">
            <canvas id="chartAlmacenes"></canvas>
          </div>
        </article>
      </section>
      <% } %>

      <section class="ios-analisis-charts is-simple">
        <article class="ios-analisis-chart-card is-wide">
          <h2>Cantidad vendida · Top <%= filtros.top %> <small style="font-weight:600;color:#8E8E93;">(con unidad)</small></h2>
          <div class="ios-analisis-chart-canvas is-h-wide">
            <canvas id="chartUnidades"></canvas>
          </div>
        </article>
        <article class="ios-analisis-chart-card is-wide">
          <h2>Ingresos (S/) · Top <%= filtros.top %></h2>
          <div class="ios-analisis-chart-canvas is-h-wide">
            <canvas id="chartIngresos"></canvas>
          </div>
        </article>
        <article class="ios-analisis-chart-card">
          <h2>Margen de ganancia (S/)</h2>
          <div class="ios-analisis-chart-canvas is-h">
            <canvas id="chartMargen"></canvas>
          </div>
        </article>
        <article class="ios-analisis-chart-card">
          <h2>Margen de ganancia (%)</h2>
          <div class="ios-analisis-chart-canvas is-h">
            <canvas id="chartMargenPct"></canvas>
          </div>
        </article>
      </section>

      <%
        function undLbl(u) {
          var c = String(u || '').toUpperCase();
          if (c === 'NIU' || c === 'UND' || c === 'ZZ') return 'und';
          if (c === 'MTR' || c === 'MT') return 'm';
          if (c === 'LTR' || c === 'LT') return 'lt';
          if (c === 'KGM' || c === 'KG') return 'kg';
          return (c || 'und').toLowerCase();
        }
        function money2(n) {
          return Number(n || 0).toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        function tipProducto(p) {
          var pct = p.margen_pct;
          if (!p.tiene_costo || pct == null) {
            return { cls: 'is-mute', text: 'Sin precio de compra: aún no se puede calcular el margen.' };
          }
          var pv = money2(p.precio_venta_medio);
          var pc = money2(p.precio_compra_medio);
          if (pct >= 50) {
            return { cls: 'is-good', text: 'Buen margen: vendes a S/ ' + pv + ' y compras a S/ ' + pc + ' en promedio.' };
          }
          if (pct >= 30) {
            return { cls: 'is-mid', text: 'Margen aceptable (venta S/ ' + pv + ' · compra S/ ' + pc + '). Puedes afinar precio o costo.' };
          }
          if (pct >= 0) {
            return { cls: 'is-low', text: 'Margen bajo: entre S/ ' + pc + ' de compra y S/ ' + pv + ' de venta queda poca ganancia.' };
          }
          return { cls: 'is-bad', text: 'Margen negativo: el precio medio de venta (S/ ' + pv + ') está bajo el de compra (S/ ' + pc + ').' };
        }
        var topVenta = (charts.top_venta || [])[0] || null;
        var topQty = (charts.top_unidades || [])[0] || null;
        var topPct = (charts.top_margen_pct || [])[0] || null;
        var listaTips = (filtros.vista === 'ingresos' || filtros.orden === 'venta')
          ? (charts.top_venta || [])
          : (charts.top_unidades || []);
      %>

      <section class="ios-analisis-tips">
        <div class="ios-analisis-tips-head">
          <h2>Tip de productos</h2>
          <p>Precios medios del periodo (pueden variar) y margen unitario.</p>
        </div>

        <div class="ios-analisis-highlights">
          <% if (topQty) { %>
          <article class="ios-analisis-hl is-blue">
            <span class="ios-analisis-hl-tag">Más vendido</span>
            <strong><%= topQty.nombre %></strong>
            <p><%= Number(topQty.unidades).toLocaleString('es-PE') %> <%= undLbl(topQty.unidad) %> · venta media S/ <%= money2(topQty.precio_venta_medio) %></p>
          </article>
          <% } %>
          <% if (topVenta) { %>
          <article class="ios-analisis-hl is-navy">
            <span class="ios-analisis-hl-tag">Más ingresos</span>
            <strong><%= topVenta.nombre %></strong>
            <p>Venta media S/ <%= money2(topVenta.precio_venta_medio) %> · margen <%= topVenta.margen_pct != null ? topVenta.margen_pct + '%' : '—' %></p>
          </article>
          <% } %>
          <% if (topPct) { %>
          <article class="ios-analisis-hl is-green">
            <span class="ios-analisis-hl-tag">Mejor margen %</span>
            <strong><%= topPct.nombre %></strong>
            <p><%= topPct.margen_pct %>% · +S/ <%= money2(topPct.margen_unitario) %> por <%= undLbl(topPct.unidad) %></p>
          </article>
          <% } %>
        </div>

        <div class="ios-analisis-tip-list">
          <% listaTips.forEach(function(p, idx) {
            var tip = tipProducto(p);
          %>
            <article class="ios-analisis-tip-card">
              <div class="ios-analisis-tip-rank"><%= idx + 1 %></div>
              <div class="ios-analisis-tip-body">
                <div class="ios-analisis-tip-title">
                  <strong><%= p.nombre %></strong>
                  <span class="ios-analisis-und-pill"><%= String(p.unidad || 'NIU').toUpperCase() %></span>
                </div>
                <div class="ios-analisis-tip-metrics">
                  <div>
                    <span>Cantidad</span>
                    <strong><%= Number(p.unidades).toLocaleString('es-PE') %> <%= undLbl(p.unidad) %></strong>
                  </div>
                  <div>
                    <span>P. venta medio</span>
                    <strong>S/ <%= p.precio_venta_medio != null ? money2(p.precio_venta_medio) : '—' %></strong>
                  </div>
                  <div>
                    <span>P. compra medio</span>
                    <strong>S/ <%= p.precio_compra_medio != null ? money2(p.precio_compra_medio) : '—' %></strong>
                  </div>
                  <div>
                    <span>Margen</span>
                    <strong class="<%= (p.margen_pct || 0) >= 0 ? 'is-ok' : 'is-bad' %>"><%= p.margen_pct != null ? p.margen_pct + '%' : '—' %><% if (p.margen_unitario != null) { %> <small>· +S/ <%= money2(p.margen_unitario) %></small><% } %></strong>
                  </div>
                </div>
                <p class="ios-analisis-tip-note <%= tip.cls %>"><%= tip.text %></p>
              </div>
            </article>
          <% }); %>
        </div>
      </section>
    <% } %>
  </main>

  <%- include('../../partials/app-tabbar', { active: active, appBase: appBase }) %>

  <script type="application/json" id="analisis-charts-data"><%- JSON.stringify({
    vista: filtros.vista || (filtros.orden === 'venta' ? 'ingresos' : 'vendidos'),
    top_unidades: (charts && charts.top_unidades) || [],
    top_venta: (charts && charts.top_venta) || [],
    top_margen: (charts && charts.top_margen) || [],
    top_margen_pct: (charts && charts.top_margen_pct) || [],
    por_almacen: (charts && charts.por_almacen) || [],
  }).replace(/</g, '\\u003c') %></script>
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Chart === 'undefined') return;
    var raw = document.getElementById('analisis-charts-data');
    if (!raw) return;
    var data;
    try { data = JSON.parse(raw.textContent || '{}'); } catch (e) { return; }
    var money = function (v) {
      return 'S/ ' + Number(v || 0).toLocaleString('es-PE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    };
    var unidadLabel = function (u) {
      var c = String(u || '').trim().toUpperCase();
      if (c === 'NIU' || c === 'UND' || c === 'ZZ') return 'und';
      if (c === 'MTR' || c === 'MT') return 'm';
      if (c === 'LTR' || c === 'LT' || c === 'GLI') return 'lt';
      if (c === 'KGM' || c === 'KG') return 'kg';
      return c ? c.toLowerCase() : 'und';
    };
    var shortName = function (n, maxLen) {
      var s = String(n || '');
      var m = maxLen || 18;
      return s.length > m ? s.slice(0, m - 1) + '…' : s;
    };
    var labelConUnidad = function (r) {
      return shortName(r.nombre, 14) + ' · ' + unidadLabel(r.unidad);
    };
    Chart.defaults.font.family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    Chart.defaults.color = '#636366';

    function barH(elId, list, valueKey, color, mode) {
      var el = document.getElementById(elId);
      if (!el || !(list || []).length) return;
      var showUnd = mode === 'qty';
      var h = Math.max(240, list.length * 34 + 48);
      if (el.parentElement) el.parentElement.style.height = h + 'px';
      new Chart(el, {
        type: 'bar',
        data: {
          labels: list.map(function (r) {
            return showUnd ? labelConUnidad(r) : shortName(r.nombre, 18);
          }),
          datasets: [{
            data: list.map(function (r) { return r[valueKey]; }),
            backgroundColor: color,
            borderRadius: 8,
            maxBarThickness: 24,
          }],
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                title: function (items) {
                  var i = items && items[0] ? items[0].dataIndex : -1;
                  var row = i >= 0 ? list[i] : null;
                  if (!row) return '';
                  return row.nombre + (row.unidad ? ' (' + String(row.unidad).toUpperCase() + ')' : '');
                },
                label: function (ctx) {
                  var row = list[ctx.dataIndex] || {};
                  var und = unidadLabel(row.unidad);
                  if (mode === 'pct') return (ctx.raw || 0) + '%';
                  if (mode === 'money') return money(ctx.raw);
                  return Number(ctx.raw || 0).toLocaleString('es-PE') + ' ' + und;
                },
              },
            },
          },
          scales: {
            x: {
              beginAtZero: true,
              grid: { color: 'rgba(0,0,0,0.05)' },
              ticks: {
                callback: function (v) {
                  if (mode === 'pct') return v + '%';
                  if (mode === 'money') return money(v);
                  return v;
                },
              },
            },
            y: { grid: { display: false } },
          },
        },
      });
    }

    function barAlmacenes(list) {
      var el = document.getElementById('chartAlmacenes');
      if (!el || !(list || []).length) return;
      var maxV = Math.max.apply(null, list.map(function (r) { return Number(r.venta || 0); }));
      var colors = list.map(function (r, i) {
        if (Number(r.venta || 0) <= 0) return 'rgba(142,142,147,0.35)';
        if (i === 0 && maxV > 0) return '#FF9F0A';
        return '#FFD60A';
      });
      var h = Math.max(220, 160 + list.length * 18);
      if (el.parentElement) el.parentElement.style.height = h + 'px';
      new Chart(el, {
        type: 'bar',
        data: {
          labels: list.map(function (r) { return shortName(r.nombre, 16); }),
          datasets: [{
            data: list.map(function (r) { return Number(r.venta || 0); }),
            backgroundColor: colors,
            borderRadius: 10,
            maxBarThickness: 48,
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                title: function (items) {
                  var i = items && items[0] ? items[0].dataIndex : -1;
                  return i >= 0 ? (list[i].nombre || '') : '';
                },
                label: function (ctx) {
                  var row = list[ctx.dataIndex] || {};
                  var parts = [money(ctx.raw)];
                  if (row.unidades != null) {
                    parts.push(Number(row.unidades).toLocaleString('es-PE') + ' und');
                  }
                  if (row.margen_pct != null) parts.push('margen ' + row.margen_pct + '%');
                  return parts.join(' · ');
                },
              },
            },
          },
          scales: {
            x: { grid: { display: false } },
            y: {
              beginAtZero: true,
              grid: { color: 'rgba(0,0,0,0.05)' },
              ticks: { callback: function (v) { return money(v); } },
            },
          },
        },
      });
    }

    barAlmacenes(data.por_almacen || []);
    barH('chartUnidades', data.top_unidades || [], 'unidades', '#007AFF', 'qty');
    barH('chartIngresos', data.top_venta || [], 'venta', '#0A84FF', 'money');
    barH('chartMargen', data.top_margen || [], 'margen', '#34C759', 'money');
    barH('chartMargenPct', data.top_margen_pct || [], 'margen_pct', '#5856D6', 'pct');
  });
  </script>
</body>
</html>
