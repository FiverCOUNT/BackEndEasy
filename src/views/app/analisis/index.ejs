<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · Easy</title>
  <link rel="stylesheet" href="/css/app-ios.css?v=analisis-simple" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js" defer></script>
</head>
<body class="ios-app">
  <%- include('../../partials/app-nav', { active: active, navItems: navItems, webUser: webUser, appBase: appBase }) %>

  <main class="ios-main">
    <header class="ios-top">
      <div>
        <p class="ios-eyebrow"><%= companyNombre || 'Empresa' %></p>
        <h1>Análisis</h1>
      </div>
    </header>

    <form class="ios-filters ios-analisis-filters" method="GET" action="<%= appBase %>/analisis">
      <div class="ios-filter-row ios-analisis-filter-row is-simple">
        <select name="periodo" class="ios-select" aria-label="Periodo" onchange="this.form.submit()">
          <option value="hoy" <%= filtros.periodo === 'hoy' ? 'selected' : '' %>>Hoy</option>
          <option value="7d" <%= filtros.periodo === '7d' ? 'selected' : '' %>>7 días</option>
          <option value="30d" <%= filtros.periodo === '30d' ? 'selected' : '' %>>30 días</option>
          <option value="mes" <%= filtros.periodo === 'mes' ? 'selected' : '' %>>Este mes</option>
          <option value="mes_ant" <%= filtros.periodo === 'mes_ant' ? 'selected' : '' %>>Mes anterior</option>
          <option value="trimestre" <%= filtros.periodo === 'trimestre' ? 'selected' : '' %>>Último trimestre</option>
          <option value="anio" <%= filtros.periodo === 'anio' ? 'selected' : '' %>>Este año</option>
        </select>
        <select name="vista" class="ios-select" aria-label="Ranking" onchange="this.form.submit()">
          <option value="vendidos" <%= (filtros.vista || filtros.orden) === 'vendidos' || filtros.orden === 'unidades' ? 'selected' : '' %>>Más vendidos</option>
          <option value="ingresos" <%= (filtros.vista || filtros.orden) === 'ingresos' || filtros.orden === 'venta' ? 'selected' : '' %>>Más ingresos</option>
        </select>
        <select name="top" class="ios-select" aria-label="Top" onchange="this.form.submit()">
          <option value="10" <%= Number(filtros.top) === 10 ? 'selected' : '' %>>Top 10</option>
          <option value="20" <%= Number(filtros.top) === 20 ? 'selected' : '' %>>Top 20</option>
        </select>
      </div>
      <input type="hidden" name="solo_costo" value="0" />
      <input type="hidden" name="desde" value="<%= filtros.desde %>" />
      <input type="hidden" name="hasta" value="<%= filtros.hasta %>" />
      <p class="ios-hint"><%= filtros.desde %> → <%= filtros.hasta %></p>
    </form>

    <section class="ios-analisis-kpis is-3">
      <article class="ios-analisis-kpi">
        <span>Ventas</span>
        <strong>S/ <%= Number(kpis.venta || 0).toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
      </article>
      <article class="ios-analisis-kpi is-ok">
        <span>Margen</span>
        <strong>S/ <%= Number(kpis.margen || 0).toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
        <small><%= kpis.margen_pct %>%</small>
      </article>
      <article class="ios-analisis-kpi">
        <span>Cantidad vendida</span>
        <strong><%= Number(kpis.unidades || 0).toLocaleString('es-PE') %></strong>
      </article>
    </section>

    <% if (!(charts && ((charts.top_unidades || []).length || (charts.top_venta || []).length))) { %>
      <section class="ios-card-empty">
        <div class="ios-empty-icon">◈</div>
        <h2>Sin ventas en este periodo</h2>
        <p>Cuando emitas facturas o boletas verás los gráficos aquí.</p>
      </section>
    <% } else { %>
      <section class="ios-analisis-charts is-simple">
        <article class="ios-analisis-chart-card is-wide">
          <h2>Cantidad vendida · Top <%= filtros.top %></h2>
          <div class="ios-analisis-chart-canvas is-h-wide">
            <canvas id="chartUnidades"></canvas>
          </div>
        </article>
        <article class="ios-analisis-chart-card is-wide">
          <h2>Ingresos (S/) · Top <%= filtros.top %></h2>
          <div class="ios-analisis-chart-canvas is-h-wide">
            <canvas id="chartIngresos"></canvas>
          </div>
        </article>
        <article class="ios-analisis-chart-card">
          <h2>Margen de ganancia (S/)</h2>
          <div class="ios-analisis-chart-canvas is-h">
            <canvas id="chartMargen"></canvas>
          </div>
        </article>
        <article class="ios-analisis-chart-card">
          <h2>Margen de ganancia (%)</h2>
          <div class="ios-analisis-chart-canvas is-h">
            <canvas id="chartMargenPct"></canvas>
          </div>
        </article>
      </section>
    <% } %>
  </main>

  <%- include('../../partials/app-tabbar', { active: active, appBase: appBase }) %>

  <script type="application/json" id="analisis-charts-data"><%- JSON.stringify({
    vista: filtros.vista || (filtros.orden === 'venta' ? 'ingresos' : 'vendidos'),
    top_unidades: (charts && charts.top_unidades) || [],
    top_venta: (charts && charts.top_venta) || [],
    top_margen: (charts && charts.top_margen) || [],
    top_margen_pct: (charts && charts.top_margen_pct) || [],
  }).replace(/</g, '\\u003c') %></script>
  <script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Chart === 'undefined') return;
    var raw = document.getElementById('analisis-charts-data');
    if (!raw) return;
    var data;
    try { data = JSON.parse(raw.textContent || '{}'); } catch (e) { return; }
    var money = function (v) {
      return 'S/ ' + Number(v || 0).toLocaleString('es-PE', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    };
    var shortName = function (n) {
      var s = String(n || '');
      return s.length > 18 ? s.slice(0, 16) + '…' : s;
    };
    Chart.defaults.font.family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    Chart.defaults.color = '#636366';

    function barH(elId, list, valueKey, color, asMoney, asPct) {
      var el = document.getElementById(elId);
      if (!el || !(list || []).length) return;
      var h = Math.max(240, list.length * 34 + 48);
      if (el.parentElement) el.parentElement.style.height = h + 'px';
      new Chart(el, {
        type: 'bar',
        data: {
          labels: list.map(function (r) { return shortName(r.nombre); }),
          datasets: [{
            data: list.map(function (r) { return r[valueKey]; }),
            backgroundColor: color,
            borderRadius: 8,
            maxBarThickness: 24,
          }],
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function (ctx) {
                  if (asPct) return (ctx.raw || 0) + '%';
                  if (asMoney) return money(ctx.raw);
                  return Number(ctx.raw || 0).toLocaleString('es-PE');
                },
              },
            },
          },
          scales: {
            x: {
              beginAtZero: true,
              grid: { color: 'rgba(0,0,0,0.05)' },
              ticks: {
                callback: function (v) {
                  if (asPct) return v + '%';
                  if (asMoney) return money(v);
                  return v;
                },
              },
            },
            y: { grid: { display: false } },
          },
        },
      });
    }

    // Destacar el ranking elegido arriba; los 4 gráficos siguen independientes.
    barH('chartUnidades', data.top_unidades || [], 'unidades', '#007AFF', false, false);
    barH('chartIngresos', data.top_venta || [], 'venta', '#0A84FF', true, false);
    barH('chartMargen', data.top_margen || [], 'margen', '#34C759', true, false);
    barH('chartMargenPct', data.top_margen_pct || [], 'margen_pct', '#5856D6', false, true);
  });
  </script>
</body>
</html>
