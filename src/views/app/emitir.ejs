<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · Easy</title>
  <link rel="stylesheet" href="/css/app-ios.css" />
</head>
<body class="ios-app">
  <%- include('../partials/app-nav', { active: active, navItems: navItems, webUser: webUser, appBase: appBase }) %>
  <main class="ios-main">
    <header class="ios-top">
      <div>
        <p class="ios-eyebrow"><%= companyNombre || 'Empresa' %></p>
        <h1>Emitir</h1>
      </div>
    </header>

    <p class="ios-muted" style="margin:0 0 12px">Elige el tipo de documento electrónico</p>

    <div class="ios-list ios-emit-list">
      <% opciones.forEach(function(op) { %>
        <a class="ios-row" href="<%= appBase %><%= op.href %>">
          <span class="ios-row-icon" style="background:<%= op.bg %>;color:<%= op.color %>"><%= op.icon %></span>
          <span class="ios-row-text">
            <strong style="color:<%= op.color %>"><%= op.titulo %></strong>
            <small>Serie <%= op.serie %> · <%= op.detalle %> · SUNAT</small>
          </span>
          <span class="ios-chevron">›</span>
        </a>
      <% }) %>
      <a class="ios-row" href="<%= appBase %><%= guiaHref %>">
        <span class="ios-row-icon" style="background:#B2EBF2;color:#006064">🚚</span>
        <span class="ios-row-text">
          <strong style="color:#006064">Guía de remisión</strong>
          <small>GRE remitente, transportista y por evento · SUNAT</small>
        </span>
        <span class="ios-chevron">›</span>
      </a>
    </div>
  </main>
  <%- include('../partials/app-tabbar', { active: active, appBase: appBase }) %>
</body>
</html>
