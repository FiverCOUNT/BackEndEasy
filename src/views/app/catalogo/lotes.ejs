<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · Easy</title>
  <link rel="stylesheet" href="/css/app-ios.css?v=lote-series" />
</head>
<body class="ios-app">
  <%- include('../../partials/app-nav', { active: active, navItems: navItems, webUser: webUser, appBase: appBase }) %>
  <main class="ios-main">
    <header class="ios-top">
      <div>
        <p class="ios-eyebrow"><%= companyNombre || 'Empresa' %></p>
        <h1><%= productoNombre ? 'Lotes del producto' : 'Lotes' %></h1>
      </div>
      <% if (productoId) { %>
        <a class="ios-btn-secondary" href="<%= appBase %>/lotes" style="flex-shrink:0;">Todos</a>
      <% } %>
    </header>

    <% if (error) { %><div class="ios-flash is-error"><%= error %></div><% } %>
    <% if (flash) { %>
      <div class="ios-flash <%= flash.type === 'error' ? 'is-error' : 'is-ok' %>"><%= flash.text %></div>
    <% } %>

    <% if (!productoId) { %>
    <section class="ios-section">
      <h3 class="ios-section-title">Nuevo lote</h3>
      <form class="ios-form" method="POST" action="<%= appBase %>/lotes">
        <section class="ios-form-card ios-lote-card">
          <label class="ios-field">
            <span>Nombre del lote</span>
            <input
              type="text"
              name="lote_nombre"
              maxlength="64"
              placeholder="Ej. LOTELECHE2028"
              value="<%= (fila && fila.nombre) || '' %>"
              autocomplete="off"
              required
            />
          </label>
          <div class="ios-lote-nuevo">
            <label class="ios-field">
              <span>Fecha de vencimiento</span>
              <input
                type="date"
                name="lote_fecha"
                value="<%= (fila && fila.fecha_vencimiento) || '' %>"
                aria-label="Fecha de vencimiento"
              />
            </label>
            <label class="ios-field">
              <span>Notificar antes</span>
              <input
                type="number"
                name="lote_dias_notificacion"
                min="1"
                max="3650"
                step="1"
                placeholder="Días"
                value="<%= (fila && fila.dias_notificacion) != null && fila.dias_notificacion !== '' ? fila.dias_notificacion : '60' %>"
                aria-label="Días de notificación"
              />
            </label>
          </div>
          <p class="ios-hint">Cuántos días antes del vencimiento se avisa. La fecha puede quedar vacía.</p>
          <button type="submit" class="ios-btn-primary">Guardar lote</button>
        </section>
      </form>
    </section>
    <% } %>

    <section class="ios-section">
      <h3 class="ios-section-title"><%= productoId ? 'Lotes usados' : 'Recientes' %></h3>
      <% if (!(lotes || []).length) { %>
        <section class="ios-card-empty">
          <div class="ios-empty-icon">▣</div>
          <h2>Sin lotes</h2>
          <% if (productoId) { %>
            <p>Este producto aún no tiene ingresos con lote.</p>
            <a class="ios-btn-primary" href="<%= appBase %>/lotes">Ver todos los lotes</a>
          <% } else { %>
            <p>El primer lote que guardes aparece aquí.</p>
          <% } %>
        </section>
      <% } else { %>
        <div class="ios-list ios-lote-list">
          <% lotes.forEach(function (lote) {
            var fecha = '';
            var raw = String(lote.fecha_vencimiento || '').slice(0, 10);
            var partes = raw.split('-');
            var meses = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
            var vencePronto = false;
            var diasAviso = Number(lote.dias_notificacion);
            if (!Number.isFinite(diasAviso) || diasAviso < 1) diasAviso = 60;
            if (partes.length === 3 && meses[Number(partes[1]) - 1]) {
              fecha = Number(partes[2]) + ' de ' + meses[Number(partes[1]) - 1] + ' ' + partes[0];
              var y = Number(partes[0]);
              var m = Number(partes[1]);
              var d = Number(partes[2]);
              if (y && m && d) {
                var venceMs = Date.UTC(y, m - 1, d);
                var hoy = new Date();
                var hoyMs = Date.UTC(hoy.getFullYear(), hoy.getMonth(), hoy.getDate());
                var dias = (venceMs - hoyMs) / 86400000;
                vencePronto = dias <= diasAviso;
              }
            }
            var qty = lote.cantidad != null ? String(lote.cantidad) : '';
            var und = lote.unidad || '';
          %>
            <% if (productoId) { %>
            <button
              type="button"
              class="ios-row ios-lote-row is-tap"
              data-lote-detalle="<%= lote.id %>"
              data-lote-nombre="<%= lote.nombre %>"
              data-lote-tipo="<%= lote.tipo || 'cantidad' %>"
            >
              <span class="ios-row-icon">▣</span>
              <span class="ios-row-text">
                <strong><%= productoNombre %></strong>
                <span class="ios-lote-nombre<%= vencePronto ? ' is-vence-rojo' : '' %>">
                  <%= lote.nombre %><%= fecha ? (' · Vence ' + fecha) : ' · Sin fecha' %>
                </span>
              </span>
              <span class="ios-valor"><%= qty %><%= und ? (' ' + und) : '' %></span>
            </button>
            <% } else { %>
            <article class="ios-row ios-row-static ios-lote-row">
              <span class="ios-row-icon">▣</span>
              <span class="ios-row-text">
                <strong><%= lote.nombre %></strong>
                <small class="<%= fecha ? (vencePronto ? 'ios-lote-fecha is-vence-rojo' : 'ios-lote-fecha') : '' %>"><%= fecha ? ('Vence ' + fecha) : 'Sin fecha' %></small>
              </span>
              <details class="ios-menu">
                <summary aria-label="Opciones del lote">⋯</summary>
                <div class="ios-menu-panel">
                  <button type="button" data-lote-productos="<%= lote.id %>" data-lote-nombre="<%= lote.nombre %>">Ver productos</button>
                </div>
              </details>
            </article>
            <% } %>
          <% }); %>
        </div>
      <% } %>
    </section>
  </main>
  <div id="loteProductosSheet" class="ios-sheet ios-sheet-compact" hidden aria-hidden="true">
    <div class="ios-sheet-panel" role="dialog" aria-modal="true">
      <div class="ios-sheet-head">
        <button type="button" class="ios-sheet-back" id="loteProductosCerrar">← Volver</button>
        <div class="ios-sheet-head-titles">
          <h3 id="loteProductosTitulo">Detalle</h3>
          <p id="loteProductosSub" class="ios-sheet-head-sub"></p>
        </div>
        <span style="width:56px;"></span>
      </div>
      <div class="ios-serie-filtros" id="loteSeriesFiltros" hidden>
        <button type="button" class="ios-serie-filtro is-on" data-lote-serie-estado="DISPONIBLE">Disponible</button>
        <button type="button" class="ios-serie-filtro" data-lote-serie-estado="ENTREGADO">Entregado</button>
      </div>
      <div class="ios-sheet-status" id="loteProductosStatus">Cargando…</div>
      <div class="ios-sheet-list" id="loteProductosLista"></div>
    </div>
  </div>
  <%- include('../../partials/app-tabbar', { active: active, appBase: appBase }) %>
  <script>
  (function () {
    var appBase = '<%= appBase %>';
    var productoId = '<%= productoId || '' %>';
    var productoNombre = <%- JSON.stringify(productoNombre || '') %>;
    var sheet = document.getElementById('loteProductosSheet');
    if (!sheet) return;
    var titulo = document.getElementById('loteProductosTitulo');
    var sub = document.getElementById('loteProductosSub');
    var statusEl = document.getElementById('loteProductosStatus');
    var lista = document.getElementById('loteProductosLista');
    var filtros = document.getElementById('loteSeriesFiltros');
    var estadoFiltro = 'DISPONIBLE';
    var cacheSeries = [];
    var cacheMeta = null;

    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function estadoInfo(raw) {
      var estado = String(raw || '').toUpperCase();
      if (estado === 'DISPONIBLE') {
        return { key: 'DISPONIBLE', label: 'Disponible', chip: 'ios-status-chip is-ok' };
      }
      if (estado.indexOf('ENTREG') >= 0 || estado === 'VENDIDO') {
        return { key: 'ENTREGADO', label: 'Entregado', chip: 'ios-status-chip is-out' };
      }
      if (estado.indexOf('RESERV') >= 0) {
        return { key: 'DISPONIBLE', label: 'Reservado', chip: 'ios-status-chip is-warn' };
      }
      return { key: estado || 'OTRO', label: raw || '—', chip: 'ios-status-chip is-mute' };
    }

    function pintarFiltros() {
      if (!filtros) return;
      filtros.querySelectorAll('[data-lote-serie-estado]').forEach(function (btn) {
        btn.classList.toggle('is-on', btn.getAttribute('data-lote-serie-estado') === estadoFiltro);
      });
    }

    function setFiltrosVisible(on) {
      if (!filtros) return;
      filtros.hidden = !on;
      if (on) pintarFiltros();
    }

    function cerrar() {
      sheet.hidden = true;
      sheet.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('ios-sheet-open');
      setFiltrosVisible(false);
      cacheSeries = [];
      cacheMeta = null;
    }

    function abrirSheet(tituloTxt, subTxt) {
      titulo.textContent = tituloTxt;
      sub.textContent = subTxt || '';
      statusEl.textContent = 'Cargando…';
      lista.innerHTML = '';
      estadoFiltro = 'DISPONIBLE';
      setFiltrosVisible(false);
      cacheSeries = [];
      cacheMeta = null;
      sheet.hidden = false;
      sheet.setAttribute('aria-hidden', 'false');
      document.body.classList.add('ios-sheet-open');
    }

    function renderSeriesLista() {
      lista.innerHTML = '';
      if (cacheMeta && cacheMeta.nombre) {
        var head = document.createElement('div');
        head.className = 'ios-sheet-item is-side ios-lote-prod-head';
        var disp = cacheSeries.filter(function (s) {
          var k = estadoInfo(s.estado).key;
          return k === 'DISPONIBLE';
        }).length;
        head.innerHTML =
          '<div class="ios-sheet-item-copy"><strong>' + esc(cacheMeta.nombre) + '</strong></div>' +
          '<span class="ios-valor">' + disp + ' und</span>';
        lista.appendChild(head);
      }
      var visibles = cacheSeries.filter(function (s) {
        return estadoInfo(s.estado).key === estadoFiltro;
      });
      if (!visibles.length) {
        statusEl.textContent = estadoFiltro === 'ENTREGADO'
          ? 'No hay series entregadas'
          : 'No hay series disponibles';
        return;
      }
      statusEl.textContent = visibles.length + ' serie' + (visibles.length === 1 ? '' : 's');
      visibles.forEach(function (s) {
        var info = estadoInfo(s.estado);
        var row = document.createElement('div');
        row.className = 'ios-sheet-item';
        var alm = s.almacen_nombre ? ('<span class="ios-serie-alm">' + esc(s.almacen_nombre) + '</span>') : '';
        row.innerHTML =
          '<strong>' + esc(s.numero_serie || '—') + '</strong>' +
          '<span class="ios-serie-meta"><span class="' + info.chip + '">' + esc(info.label) + '</span>' + alm + '</span>';
        lista.appendChild(row);
      });
    }

    function pintarSeriesDeProducto(it) {
      cacheMeta = { nombre: it.nombre || productoNombre || 'Producto' };
      cacheSeries = it.series || [];
      setFiltrosVisible(true);
      renderSeriesLista();
    }

    function pintarProductos(items) {
      lista.innerHTML = '';
      if (!items.length) {
        statusEl.textContent = 'Este lote no tiene productos en stock.';
        setFiltrosVisible(false);
        return;
      }
      var soloSerie = items.length === 1 && items[0].tipo === 'serie';
      if (soloSerie) {
        pintarSeriesDeProducto(items[0]);
        return;
      }
      setFiltrosVisible(false);
      statusEl.textContent = items.length + ' producto' + (items.length === 1 ? '' : 's');
      items.forEach(function (it) {
        var row = document.createElement('div');
        row.className = 'ios-sheet-item is-side';
        if (it.tipo === 'serie') {
          var series = it.series || [];
          var disp = series.filter(function (s) { return estadoInfo(s.estado).key === 'DISPONIBLE'; }).length;
          var ent = series.filter(function (s) { return estadoInfo(s.estado).key === 'ENTREGADO'; }).length;
          row.innerHTML =
            '<div class="ios-sheet-item-copy">' +
              '<strong>' + esc(it.nombre) + '</strong>' +
              '<span class="ios-serie-meta">' +
                '<span class="ios-status-chip is-ok">' + disp + ' disp.</span>' +
                (ent ? '<span class="ios-status-chip is-out">' + ent + ' ent.</span>' : '') +
              '</span>' +
            '</div>' +
            '<span class="ios-valor">' + disp + ' und</span>';
          row.style.cursor = 'pointer';
          row.addEventListener('click', function () {
            titulo.textContent = it.nombre || 'Producto';
            pintarSeriesDeProducto(it);
          });
        } else {
          row.innerHTML =
            '<div class="ios-sheet-item-copy"><strong>' + esc(it.nombre) + '</strong></div>' +
            '<span class="ios-valor">' + esc(String(it.cantidad || '') + ' ' + String(it.unidad || '')) + '</span>';
        }
        lista.appendChild(row);
      });
    }

    function pintarDetalleProducto(items) {
      lista.innerHTML = '';
      var it = (items || [])[0];
      if (!it) {
        statusEl.textContent = 'Sin stock disponible en este lote.';
        setFiltrosVisible(false);
        return;
      }
      if (it.tipo === 'serie') {
        pintarSeriesDeProducto(it);
        return;
      }
      setFiltrosVisible(false);
      statusEl.textContent = 'Cantidad disponible';
      var row = document.createElement('div');
      row.className = 'ios-sheet-item is-side';
      row.innerHTML =
        '<div class="ios-sheet-item-copy">' +
          '<strong>' + esc(productoNombre || it.nombre) + '</strong>' +
        '</div>' +
        '<span class="ios-valor">' + esc(String(it.cantidad || '') + ' ' + String(it.unidad || '')) + '</span>';
      lista.appendChild(row);
    }

    filtros && filtros.addEventListener('click', function (ev) {
      var btn = ev.target.closest('[data-lote-serie-estado]');
      if (!btn) return;
      estadoFiltro = btn.getAttribute('data-lote-serie-estado') || 'DISPONIBLE';
      pintarFiltros();
      renderSeriesLista();
    });

    document.addEventListener('click', function (ev) {
      var detalleBtn = ev.target.closest('[data-lote-detalle]');
      if (detalleBtn && productoId) {
        ev.preventDefault();
        var loteId = detalleBtn.getAttribute('data-lote-detalle');
        var loteNombre = detalleBtn.getAttribute('data-lote-nombre') || 'Lote';
        abrirSheet(productoNombre || 'Producto', loteNombre);
        fetch(appBase + '/lotes/' + encodeURIComponent(loteId) + '/productos?producto=' + encodeURIComponent(productoId), {
          headers: { Accept: 'application/json' },
          credentials: 'same-origin',
        })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (!data || data.success === false) {
              statusEl.textContent = 'No se pudo cargar el detalle.';
              return;
            }
            pintarDetalleProducto(data.items || [], loteNombre);
          })
          .catch(function () {
            statusEl.textContent = 'No se pudo cargar el detalle.';
          });
        return;
      }

      var btn = ev.target.closest('[data-lote-productos]');
      if (!btn) return;
      ev.preventDefault();
      var details = btn.closest('details.ios-menu');
      if (details) details.open = false;
      var id = btn.getAttribute('data-lote-productos');
      var nombre = btn.getAttribute('data-lote-nombre') || 'Lote';
      abrirSheet('Productos', nombre);
      fetch(appBase + '/lotes/' + encodeURIComponent(id) + '/productos', {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data || data.success === false) {
            statusEl.textContent = 'No se pudieron cargar los productos.';
            return;
          }
          pintarProductos(data.items || []);
        })
        .catch(function () {
          statusEl.textContent = 'No se pudieron cargar los productos.';
        });
    });

    document.getElementById('loteProductosCerrar').addEventListener('click', cerrar);
    sheet.addEventListener('click', function (ev) {
      if (ev.target === sheet) cerrar();
    });
  })();
  </script>
</body>
</html>
