<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — BackEnd Easy</title>
  <link rel="stylesheet" href="/css/style.css?v=20260926panel" />
</head>
<body>
  <header class="header">
    <h1>BackEnd Easy</h1>
    <p>Panel web</p>
  </header>

  <main class="container layout-with-nav">
    <%- include('../partials/nav', { active: 'usuarios' }) %>

    <div class="main-content">
    <section class="card">
      <div class="card-header-row">
        <div>
          <h2><%= title %></h2>
          <p class="api-hint"><%= total %> usuario(s) en <%= entorno === 'beta' ? 'beta' : 'producción' %></p>
        </div>
        <a href="<%= adminBase %>/usuarios/crear" class="btn-link">+ Nuevo usuario</a>
      </div>

      <%- include('../partials/flash', { flash }) %>

      <form class="list-search" method="GET" action="<%= searchAction %>">
        <input type="hidden" name="entorno" value="<%= entorno %>" />
        <div class="list-search-row">
          <input
            type="search"
            name="q"
            value="<%= typeof q !== 'undefined' ? q : '' %>"
            placeholder="<%= searchPlaceholder %>"
            class="list-search-input"
            autocomplete="off"
          />
          <select name="company" class="list-filter-select">
            <option value="">Todas las empresas</option>
            <option value="none" <%= companyId === 'none' ? 'selected' : '' %>>Sin empresa (plataforma)</option>
            <% (companies || []).forEach(function(c) { %>
              <option value="<%= c.id %>" <%= String(companyId) === String(c.id) ? 'selected' : '' %>>
                <%= c.nombre %> · <%= c.ruc %>
              </option>
            <% }); %>
          </select>
          <button type="submit" class="btn-sm btn-edit">Buscar</button>
          <% if (q || companyId) { %>
            <a href="<%= searchAction %>?entorno=<%= entorno %>" class="btn-sm btn-clear">Limpiar</a>
          <% } %>
        </div>
        <% if (typeof pageSize !== 'undefined') { %>
          <input type="hidden" name="limit" value="<%= pageSize %>" />
        <% } %>
      </form>

      <%- include('../partials/pagination', { pagination, q, paginationPosition: 'header' }) %>

      <% if (usuarios.length === 0) { %>
        <p class="empty-state">
          <% if (q) { %>
            No hay resultados para «<%= q %>».
          <% } else { %>
            No hay usuarios. <a href="<%= adminBase %>/usuarios/crear">Crear el primero</a>
          <% } %>
        </p>
      <% } else { %>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Empresa</th>
                <th>Almacén</th>
                <th>Sesión</th>
                <th>Actualizado</th>
                <th class="col-actions">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% usuarios.forEach(function(u) { %>
                <tr>
                  <td><%= u.id %></td>
                  <td><strong><%= u.email %></strong></td>
                  <td>
                    <span class="badge <%= (u.rol === 'ADMIN' || u.rol === 'SUPER_ADMIN') ? 'badge-activo' : '' %>"><%= u.rol %></span>
                  </td>
                  <td><span class="badge badge-<%= u.estado.toLowerCase() %>"><%= u.estado %></span></td>
                  <td>
                    <% if (u.companyNombre) { %>
                      <%= u.companyNombre %><br />
                      <small class="muted">RUC <%= u.companyRuc %></small>
                    <% } else { %>
                      <span class="muted">—</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (u.almacenNombre) { %>
                      <%= u.almacenNombre %>
                      <% if (u.almacenCodigo) { %><br /><small class="muted"><%= u.almacenCodigo %></small><% } %>
                    <% } else { %>
                      <span class="muted">—</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (u.hasSession) { %>
                      <span class="badge badge-activo">Activa</span>
                    <% } else { %>
                      <span class="muted">Sin token</span>
                    <% } %>
                  </td>
                  <td class="muted"><%= u.lastUpdated %></td>
                  <td>
                    <div class="actions-cell">
                      <a href="<%= adminBase %>/usuarios/<%= u.id %>/editar?entorno=<%= entorno %>" class="btn-sm btn-edit">Editar</a>

                      <% if (u.estado !== 'ACTIVO') { %>
                        <form method="POST" action="<%= adminBase %>/usuarios/<%= u.id %>/activar" class="inline-form">
                          <input type="hidden" name="entorno" value="<%= entorno %>" />
                          <button type="submit" class="btn-sm btn-success">Activar</button>
                        </form>
                      <% } else { %>
                        <form method="POST" action="<%= adminBase %>/usuarios/<%= u.id %>/desactivar" class="inline-form">
                          <input type="hidden" name="entorno" value="<%= entorno %>" />
                          <button type="submit" class="btn-sm btn-warn">Desactivar</button>
                        </form>
                      <% } %>

                      <form
                        method="POST"
                        action="<%= adminBase %>/usuarios/<%= u.id %>/eliminar"
                        class="inline-form"
                        onsubmit="return confirm('¿Eliminar usuario <%= u.email %>? Esta acción no se puede deshacer.');"
                      >
                        <input type="hidden" name="entorno" value="<%= entorno %>" />
                        <button type="submit" class="btn-sm btn-danger">Eliminar</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <%- include('../partials/pagination', { pagination, q, paginationPosition: 'footer' }) %>
      <% } %>
    </section>
    </div>
  </main>
</body>
</html>
