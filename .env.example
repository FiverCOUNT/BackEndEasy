PORT=3000
NODE_ENV=development

# MySQL — Prisma arma DATABASE_URL automáticamente desde estas variables
# Producción (empresas entorno=prod) → DB_NAME
# Beta/test (empresas entorno=beta) → DB_NAME_TEST
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_easy
DB_NAME_TEST=db_easy_test
DB_USER=root
DB_PASSWORD=77437644

# Pool Prisma: consultas simultáneas a MySQL, no cantidad de clientes.
# 15 alcanza para cientos de usuarios; no pongas 100.
# DB_CONNECTION_LIMIT=15
# DB_POOL_TIMEOUT=20
# DB_CONNECT_TIMEOUT=10

# Solo si prefieres URL completa (tiene prioridad sobre DB_*). Si la usas, añade:
# ?connection_limit=15&pool_timeout=20&connect_timeout=10
# DATABASE_URL=mysql://root:tu_password_mysql@localhost:3306/db_easy
# DATABASE_URL_TEST=mysql://root:tu_password_mysql@localhost:3306/db_easy_test
# DATABASE_URL_PROD=mysql://root:tu_password_mysql@localhost:3306/db_easy

# Si falla con "auth_gssapi_client", en MySQL/MariaDB ejecuta:
# ALTER USER 'root'@'localhost' IDENTIFIED VIA mysql_native_password USING PASSWORD('tu_clave');
# FLUSH PRIVILEGES;

# JWT (autenticación)
JWT_SECRET=asasasasasasasasadwswerw
JWT_REFRESH_SECRET=jhonnyaa
JWT_ACCESS_EXPIRES=30d
JWT_REFRESH_EXPIRES=30d

# Sesión del panel web (cookie). Si no está, usa JWT_SECRET.
SESSION_SECRET=cambia-este-secreto-del-panel-web

# Admin del panel (script: node scripts/ensure-web-admin.js)
WEB_ADMIN_EMAIL=admin@factapp.local
WEB_ADMIN_PASSWORD=Admin123!

# Servicio PHP EMISOR (emisión SUNAT)
EMISOR_API_URL=http://localhost:8080
EMISOR_API_TIMEOUT_MS=120000
# true = permite emitir sin credenciales SUNAT en la empresa (EMISOR usa demo del .env)
EMISOR_SUNAT_ALLOW_INCOMPLETE=false

# Cloudflare R2 (bucket: sistemafacturacion)
S3_ENDPOINT=https://ee120001475f11c2557f8e8363584b10.r2.cloudflarestorage.com
S3_BUCKET=sistemafacturacion
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Carpetas dentro del bucket
S3_PREFIX_COMPROBANTES=comprobantes
S3_PREFIX_CERTIFICADOS=certificados
S3_PREFIX_ADJUNTOS=adjuntos
S3_PREFIX_CONFIGURACION=configuracion
S3_PREFIX_LOGOS=logos
# URL pública del bucket (R2 public bucket o dominio custom) — obligatoria en producción con R2
# Ejemplo: https://pub-xxxx.r2.dev  o  https://archivos.tudominio.com
S3_PUBLIC_BASE_URL=

# Consulta RUC (opcional). Si no hay token, solo busca en tu BD de clientes/empresas.
# APIS_NET_TOKEN=tu_token_apis_net_pe
# APISPERU_TOKEN=tu_token_apisperu

# Scraper GRE (portal SOL vía Playwright — proyecto scraping en puerto 3001)
GRE_SCRAPER_URL=http://localhost:3001
# GRE_SCRAPER_TIMEOUT_MS=600000

# En SOL el client_id debe tener activado el recurso «Envíos SP» / CPE receptor.
# SUNAT_API_SCOPE=https://api.sunat.gob.pe/v1/contribuyente/contribuyentes
# SUNAT_SSPP_SCOPE=
# SUNAT_SSPP_URL=https://api.sunat.gob.pe/v1/contribuyente/enviossp
